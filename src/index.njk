---
layout: base.njk
title: "Weekend Craft Lab"
permalink: /
---
<section class="hero">
  <h1>{{ site.title }}</h1>
  <p>{{ site.intro }}</p>
</section>
<section aria-label="Latest posts">
  <h2 class="section-title">Latest posts</h2>
  <ul class="post-list">
  {%- for post in collections.posts %}
    <li class="card">
      <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.description }}</p>
    </li>
  {%- endfor %}
  </ul>
</section>
